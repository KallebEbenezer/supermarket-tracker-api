# Database (Supabase)
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxx
DB_PASSWORD=your-db-password

# JWT
APP_JWT_SECRET=your-jwt-secret-min-256-bits

# Mercado Pago
PIX_MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Cartão — mercadopago (default) | sumup | mock
CARTAO_PROVIDER=mercadopago

# SumUp para conciliação (obrigatório quando CARTAO_PROVIDER=sumup).
# Nunca commitar valores reais.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# SumUp Tap-to-Pay: credenciais OAuth de servidor. O endpoint do app devolve
# apenas access_token de curta duração; estes três valores nunca saem do Render.
SUMUP_OAUTH_CLIENT_ID=
SUMUP_OAUTH_CLIENT_SECRET=
SUMUP_OAUTH_REFRESH_TOKEN=
# Deve ser idêntica à URL cadastrada nas credenciais OAuth da SumUp.
SUMUP_OAUTH_REDIRECT_URI=https://supermarket-tracker-api.onrender.com/api/v1/integracoes/sumup/oauth/callback

# PIX
PIX_MOCK_ENABLED=false

# Email (opcional)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@supermarkettracker.com.br
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
